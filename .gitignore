/target
# Cargo.lock is committed: reproducible, locked dependency resolution for
# the build/test/clippy gates (cargo … --locked). Do not re-ignore.
*.img
# ...except this one fixture, which IS committed. A mkfs.erofs built
# without libzstd cannot produce a zstd image, and most packaged builds
# are not built with it, so `tests/zstd_image.rs` carries the image
# rather than depending on what happens to be installed. Named
# individually rather than un-ignoring the whole directory, so a stray
# local image dropped in test-disks/ still stays out.
!test-disks/erofs-zstd-4k.img
*audit*
.history

# GSI test fixture (downloaded by tests/fixtures/download-gsi.sh).
# AOSP-licensed; not redistributed by this repo. The *.img rule above
# already covers system.img, but be explicit for the .tar / .zip
# intermediate forms as well.
tests/fixtures/*.img
tests/fixtures/*.tar*
tests/fixtures/*.zip

# chore fingerprint cache (sources:/generates: checksums). Derived data.
.chore/

# Build output. `chore staticlib` writes the archive and headers here for a
# consumer to copy out of (`chore artifact` prints this directory).
/dist/
.DS_Store
